{
  // Type gate for the TypeScript front-end (web/src). CI runs
  //   npx -y typescript@5 tsc --noEmit -p crates/ayame-cli/web/tsconfig.json
  // The shipped build does NOT use tsc — build.rs (oxc) does the type-strip.
  //
  // The broad compatibility gate remains pragmatic while tsconfig.strict.json
  // enforces strictNullChecks on migrated leaf modules. Move files into that
  // gate as their boundaries become explicit; noImplicitAny remains the next
  // whole-frontend migration step.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],

    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `files` force-includes the ambient global augmentation (Window IPC/host
  // hooks); a bare `**/*.ts` glob does not reliably pull in a lone .d.ts.
  "files": ["src/env.d.ts"],
  "include": ["src/**/*.ts"]
}
